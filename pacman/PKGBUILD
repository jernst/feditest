url="https://feditest.org/"
developer=${url}
maintainer=${url}
pkgname=feditest
pkgver=0.6.1
pkgrel=1
pkgdesc="Framework to test distributed, heterogeneous systems with complex protocols such as the Fediverse"
arch=('any')
license=('MIT')
depends=(
    'python'
    'python-beautifulsoup4'
    'python-cryptography'
    'python-httpx'
    'python-langcodes'
    'python-msgspec'
    'python-multidict'
    'python-jinja'
    'python-pyhamcrest'
    'python-pytest'
    'python-requests'
)
options=('!strip')

makedepends=(
    'python-build'
    'python-hatchling'
    'python-installer'
    'rsync'
)
checkdepends=(
    'mypy'
    'pyright'
    'python-pytest'
    'ruff'
)

prepare() {
    # Update pyproject.toml
    perl -pi -e 's/^(name\s*=\s*")([^"]+)("\s*$)/${1}'"$pkgname"'${3}/' ../../pyproject.toml
    perl -pi -e 's/^(version\s*=\s*")([^"]+)("\s*$)/${1}'"$pkgver"'${3}/' ../../pyproject.toml
    perl -pi -e 's/^(description\s*=\s*")([^"]+)("\s*$)/${1}'"$pkgdesc"'${3}/' ../../pyproject.toml
}

build() {
    cd ${startdir}/..
    python -m build --wheel --no-isolation --outdir "${srcdir}"
}

check() {
    cd ${startdir}/../
    echo Running pyright
    pyright -p ${startdir}

    cd ${startdir}/../src
    echo Running ruff check
    ruff check

    echo Running mypy
    MYPATH=. mypy --namespace-packages --explicit-package-bases --follow-untyped-imports .

    cd ${startdir}/../
    echo Running pytest
    PYTHONPATH=src pytest -v
}

package() {
    python -m installer --destdir="${pkgdir}" "${srcdir}"/*.whl
}
